{
  "name": "madrasat-ibnuhajar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MADRASAT IBNUHAJAR \u2014 school communication & exam records platform for teachers, parents and admins.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=esm --jsx=automatic --external:jsdom --outfile=node_modules/.tmp/smoke.mjs --log-level=error && node node_modules/.tmp/smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
